# Environment variables for ChefMom
# Copy this file to .env.local (not committed) and fill in your Gemini API keys.
# You can provide either a single GEMINI_API_KEY or a comma-separated list via GEMINI_API_KEYS.

# Single key option (used if GEMINI_API_KEYS is not set)
# GEMINI_API_KEY=your_gemini_api_key_here

# Multiple keys option (preferred): comma-separated list of keys
# GEMINI_API_KEYS=key1,key2,key3
